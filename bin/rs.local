#!/bin/sh
# Type `rs.local` in any terminal to start the UI (if needed) and open it.
#
# Put this on your PATH yourself, next to `rt`. See README → Use `rt` from any folder.
#
# Optional, so the browser address is http://rs.local:8000 instead of localhost:
#   sudo sh -c 'grep -q "[[:space:]]rs.local" /etc/hosts || echo "127.0.0.1 rs.local" >> /etc/hosts'

set -e
SOURCE=$0
while [ -L "$SOURCE" ]; do
  DIR=$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)
  SOURCE=$(readlink "$SOURCE")
  case $SOURCE in
    /*) ;;
    *) SOURCE=$DIR/$SOURCE ;;
  esac
done
HERE=$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)
ROOT=$(CDPATH= cd -- "$HERE/.." && pwd)
RT="$ROOT/.venv/bin/rt"
if [ ! -x "$RT" ]; then
  RT="$ROOT/.venv/Scripts/rt.exe"
fi
if [ ! -x "$RT" ]; then
  echo "resume-tailor: the project venv has no rt command." >&2
  echo "From the project folder, create .venv and run: python -m pip install -e ." >&2
  exit 127
fi
export RESUME_TAILOR_ROOT="$ROOT"
exec "$RT" open "$@"
