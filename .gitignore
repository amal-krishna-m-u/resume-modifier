# --- Personal data: stays local, never pushed -------------------------
# The whole knowledge base stays local. This repository is PUBLIC, and kb/
# holds the complete career record: every employer, location, date and
# achievement, plus the working notes written against them. None of that
# should be indexable under the owner's name.
#
# kb/ is versioned instead by its OWN git repository, which has no remote, so
# history, diff and revert all keep working (AC-R8.3, spec-04 §3) without
# anything being published. See README -> Local setup.
#
# Only the template is tracked here, because a fresh clone needs it.
kb/*
!kb/identity.example.yaml

# Supporting evidence: certificates, offer letters, reference docs
evidence/

# Source resumes and any PDF/DOCX dropped in for bootstrapping
*.pdf
*.docx

# --- Generated output -------------------------------------------------
# Neither runs/ nor applications/ is tracked (open-questions OQ-3, resolved
# 2026-10-07). applications/ holds complete resumes with both contact sets,
# job descriptions, and third-party referrer names; this repo is public.
runs/
applications/
.cache/

# The knowledge-base chat: your career, in your own words.
chats/

# Saved tag weightings per role type. They encode what the owner is targeting,
# which is personal even though it holds no contact details.
profiles/

# --- Environment ------------------------------------------------------
# Both spellings, at any depth: .venv/, venv/, spike/venv/ all match.
.venv/
venv/
env/
__pycache__/
*.pyc
.env
.env.local

node_modules/
dist/
.vite/
*.tsbuildinfo

.DS_Store
